      <column caption='Platform Allocation' datatype='integer' name='[Calculation_2580844065368514560]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [platform] = &quot;Instagram&quot; THEN 3500&#13;&#10;ELSEIF [platform] = &quot;LinkedIn&quot; THEN 1500&#13;&#10;ELSE 0&#13;&#10;END' />
